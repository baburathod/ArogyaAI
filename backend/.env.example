# MongoDB Atlas Connection
# Get your connection string from MongoDB Atlas console
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/arogya?retryWrites=true&w=majority

# Server Configuration
PORT=3000
NODE_ENV=development

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=your_jwt_secret_key_here
BACKEND_HOSPITALS_API=https://example.com/hospitals?key=YOUR_KEY

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email Service (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Twilio (for SMS notifications)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
